# Admin portal environment.
#
# This app talks to the SAME Laravel backend as the customer app, but only
# hits the /api/admin/* routes (which are gated by EnsureAdminOrigin + the
# `admin` middleware). The backend MUST list this origin in its
# ADMIN_PORTAL_ORIGINS env var or every request will get a 403.

# Backend API origin. In dev the customer + admin share a backend at
# http://20.102.97.203:8000/api (the same value the customer client uses).
VITE_API_BASE_URL=http://20.102.97.203:8000/api

# App identity (shown in the UI; harmless if left blank).
VITE_APP_ENV=development

# Auto-logout after N minutes of inactivity. The admin shell installs an
# idle-timeout watchdog (Layout.jsx) that calls forceLogout when the
# threshold is crossed.
VITE_IDLE_TIMEOUT_MINUTES=15
